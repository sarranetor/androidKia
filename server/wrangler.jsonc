{
  "name": "ehi-macchina",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // serve alla libreria OAuth per verificare i "Client ID Metadata Document" in modo sicuro
  "compatibility_flags": ["global_fetch_strictly_public"],
  "kv_namespaces": [
    // Token e client OAuth. Per lo sviluppo locale basta un id qualsiasi; in produzione: wrangler kv namespace create OAUTH_KV
    { "binding": "OAUTH_KV", "id": "b77da07a62d14635984cd21657de25a2" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ehi-macchina",
      // Segnaposto per lo sviluppo locale. Dopo `wrangler d1 create ehi-macchina`
      // si sostituisce con l'id vero (vedi README).
      "database_id": "b5174c0f-b217-42f9-8ae9-22b02556771c",
      "migrations_dir": "migrations"
    }
  ]
}
